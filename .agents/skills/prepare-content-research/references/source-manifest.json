      "night_protection": [
        "topic.night_protection.v1",
        "base.general_advice.v1",
        "base.safety_boundaries.v1"
      ]
    },
    "runtime_behavior_claims": {
      "source_type": "repository_runtime",
      "paths": [
        "src/lib/agent-v2/guidance/package-index.ts",
        "src/lib/agent-v2/guidance/compiler.ts",
        "src/lib/agent-v2/guidance/types.ts",
        "src/lib/agent-v2/tools/guidance-tool.ts",
        "src/lib/recommendation-engine/categories/shampoo.ts",
        "src/lib/recommendation-engine/categories/conditioner.ts",
        "src/lib/recommendation-engine/categories/leave-in.ts",
        "src/lib/recommendation-engine/categories/mask.ts",
        "src/lib/recommendation-engine/categories/oil.ts",
        "src/lib/recommendation-engine/categories/bondbuilder.ts",
        "src/lib/recommendation-engine/categories/deep-cleansing-shampoo.ts",
        "src/lib/recommendation-engine/categories/dry-shampoo.ts",
        "src/lib/recommendation-engine/categories/peeling.ts",
        "src/lib/recommendation-engine/categories/index.ts",
        "src/lib/recommendation-engine/runtime.ts",
        "src/lib/recommendation-engine/types.ts",
        "tests/agent-v2-guidance-compiler.spec.ts",
        "tests/recommendation-engine-categories.test.ts"
      ]
    },
    "named_product_claims": {
      "source_type": "repository_product_data",
      "paths": [
        "data/product-catalog-snapshot.json",
        "data/product-catalog-normalization.json",
        "data/product-catalog-normalization.schema.json",
        "docs/product-catalog-identity-rules.md",
        "docs/product-identity-normalization.md",
        "src/lib/product-identity/index.ts",
        "src/lib/product-identity/normalize.ts",
        "src/lib/product-identity/brand-resolution.ts",
        "src/lib/agent-v2/named-product-context.ts",
        "src/lib/product-display-name.ts",
        "src/lib/product-catalog/eligibility.ts"
      ],
      "freshness_rule": "For current formula, price, availability, packaging, or live retailer claims, record a repository gap and use current_product_source evidence through the external gate."
    },
    "external_gap_triggers": [
      "scientific_or_ingredient_question_not_directly_supported_by_repo",
      "medically_adjacent_scalp_or_hair_loss_boundary",
      "current_formula_or_market_claim",
      "professional_or_regulatory_claim_needed_for_safe_framing"
    ],
    "audit_only_sources": [
      "docs/agent-v2-guidance-migration/category-guidance-standard.md",
      "docs/agent-v2-guidance-migration/source-map.md"
    ]
  },
  "excluded_primary_sources": [
    {
      "path_prefix": "plans/",
      "reason": "Planning artifacts are not content authority."
    },
    {
      "path_prefix": "docs/archive/",
      "reason": "Archived docs may be stale."
    },
    {
      "path_prefix": "docs/agent-v2-guidance-migration/",
      "reason": "Migration docs are audit-only and must not become primary content authority."
    },
    {
      "path_prefix": "data/agent-guidance/",
      "reason": "Legacy guidance is superseded by data/agent-v2/guidance packages."
    },
    {
      "path_prefix": "src/",
      "reason": "Unbounded source search is excluded; use only exact runtime paths listed in conditional_sources."
    },
    {
      "pattern": "repo-wide-search",
      "reason": "Repository-wide retrieval is not an allowed primary source selection method."
    }
  ]
}
