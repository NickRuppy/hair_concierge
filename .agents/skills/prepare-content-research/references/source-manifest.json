        "category.leave_in.v1",
        "category.shampoo.v1"
      ],
      "category.leave_in.v1": ["category.conditioner.v1", "category.mask.v1", "category.oil.v1"],
      "category.mask.v1": [
        "category.conditioner.v1",
        "category.leave_in.v1",
        "category.bondbuilder.v1"
      ],
      "category.oil.v1": ["category.leave_in.v1", "category.mask.v1"],
      "category.bondbuilder.v1": ["category.mask.v1", "category.conditioner.v1"],
