[Unit]
Description=Chaarlie Product Intake Review Cockpit
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=nick
Group=nick
UMask=0027
WorkingDirectory=/opt/chaarlie/product-intake/current
EnvironmentFile=/opt/chaarlie/product-intake/shared/worker.env
Environment=PRODUCT_INTAKE_FINALIZED_IMAGE_DIR=/opt/chaarlie/product-intake/shared/finalized-images
Environment=PRODUCT_INTAKE_CODEX_WORKER_EXTERNAL=true
ExecStart=/usr/local/bin/npm run start --workspace @chaarlie/product-intake-review -- --hostname 127.0.0.1 --port 3910
Restart=on-failure
RestartSec=15
Nice=10
MemoryMax=256M

[Install]
WantedBy=multi-user.target
