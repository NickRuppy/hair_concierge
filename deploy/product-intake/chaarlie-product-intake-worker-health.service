[Unit]
Description=Chaarlie Product Intake worker health observer
After=network-online.target chaarlie-product-intake-worker.service
Wants=network-online.target

[Service]
Type=oneshot
User=nick
Group=nick
UMask=0027
WorkingDirectory=/opt/chaarlie/product-intake/current
EnvironmentFile=-/opt/chaarlie/product-intake/current/.env.local
EnvironmentFile=/opt/chaarlie/product-intake/shared/worker.env
EnvironmentFile=-/opt/chaarlie/product-intake/shared/release.env
ExecStart=/usr/bin/python3 /opt/chaarlie/product-intake/current/deploy/product-intake/worker-health.py
TimeoutStartSec=30s
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/chaarlie/product-intake/shared
