[Unit]
Description=Chaarlie recurring price audit (apply mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nick
Group=nick
UMask=0027
WorkingDirectory=/opt/chaarlie/price-audit/current
Environment=NODE_ENV=production
Environment=HOME=/home/nick
EnvironmentFile=/opt/chaarlie/price-audit/shared/worker.env
ExecStart=/usr/bin/python3 /opt/chaarlie/product-intake/current/deploy/product-intake/heavy-stage.py --kind price-audit --run-timeout-ms 10800000 -- /usr/local/bin/npm run price-audit -- --apply --llm-budget 100
MemoryMax=1G
Nice=10
TimeoutStartSec=3h
TimeoutStopSec=30s
KillMode=control-group
OOMPolicy=stop
