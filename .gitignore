# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.swp

# worktrees
.worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# claude code (local settings only — shared settings.json is tracked)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/local/
.claude/skills/local/
.claude/skills/challenge-me/

# vercel
