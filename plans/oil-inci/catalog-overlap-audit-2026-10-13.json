  "count_query_sql": "SELECT count(*)::int AS current_oil_catalog_products, count(*) FILTER (WHERE s.product_id IS NOT NULL)::int AS with_oil_specs, count(*) FILTER (WHERE p.is_active)::int AS active, count(*) FILTER (WHERE p.is_chaarlie_recommended)::int AS recommended FROM public.products p LEFT JOIN public.product_oil_specs s ON s.product_id=p.id WHERE lower(coalesce(p.category_key,p.category,''))='oil' OR s.product_id IS NOT NULL;",
