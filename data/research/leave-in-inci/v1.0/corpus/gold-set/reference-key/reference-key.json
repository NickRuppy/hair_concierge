  "lane_decisions_not_in_the_standard": [
    {
      "id": "LD-1",
      "rule": "A monomeric long-chain quat alone (Behentrimonium/Cetrimonium Chloride, Behentrimonium Methosulfate) does NOT reach PERS `permanent_cationic`; it is recorded as `neutral_non_volatile` with the charge-substantivity mechanism noted. Polymeric permanent quats (polyquaterniums, Guar HPTC) and silicone quats DO reach it.",
      "reason": "The §7.6 class anchors enumerate silicone quats, high-charge-density polyquaterniums, cationised proteins, amodimethicone and amidoamines. They give no class for a monomeric permanent quat.",
      "affects_slots": [2, 3, 5, 10, 11]
    },
    {
      "id": "LD-2",
      "rule": "A generic cationic polymer whose charge density is unreadable from INCI does not set R2 `candidate`.",
      "reason": "§7.10's `candidate` anchor lists 'high-charge cationic polymer', but 'high-charge' is exactly the property G4 forbids reading off a consumer list; and §10.2/§10.3 explicitly bar a generic cationic polymer from setting a repair focus or a damage upgrade.",
      "affects_slots": [3, 6, 8]
    },
    {
      "id": "LD-3",
      "rule": "WT `high` requires one of the anchor's three literal limbs (LGN pair above the tail; two-plus persistent non-volatile families WITH a rich/low-spreading band member; two-phase/microemulsion carrying a substantial oil/silicone phase). Several LIGHT/MEDIUM persistent non-volatile families without a rich-band member fall to `moderate`.",
      "reason": "The anchor's grammar makes the rich-band member a qualifier on the family-count limb; §10.1 additionally instructs against encoding unresolved uncertainty as a restrictive `high`.",
      "affects_slots": [5, 8, 9]
    },
    {
      "id": "LD-4",
      "rule": "scalp_application_fit derivation used where §10.3 gives only 'derived from directions plus EXPO, default unknown when silent': directions explicitly restricting placement to lengths/ends -> `avoid`; directions extending toward the root area without a scalp statement -> `conditional`; directions silent on placement -> `unknown`.",
      "reason": "Implementation default, needed for consistency across the set. Never derived from an ingredient read; G6 applies throughout.",
      "affects_slots": [1, 3, 4]
    }
  ],
