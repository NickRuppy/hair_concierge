    "fu_grading_masks": [
      {
        "source_slug": "got2b-gotgloss-glanz-spray",
        "field": ".directions.text",
        "replacements": 1,
        "before": "Anwendung: Das [CLAIM] Spray auf trockenes Haar auftragen und kurz einwirken lassen. Haare im Anschluss Glätten um den [CLAIM] zu verstärken. Bei Bedarf das Spray noch einmal als Finisch aufsprühen. Styling Hack: Für die ultimative \"Glass Hair\" Routine, zuerst den [CLAIM] Primer im handtuchtrockenen Haar verteilen und die Haare föhnen. Im Anschluss das [CLAIM] Spray auf das trockene Haar sprühen und die Haare glätten. Das Ergebnis: Spiegelglänzendes, glattes \"Glass Hair\" Haar!",
        "after": "Anwendung: Das [CLAIM] Spray auf trockenes Haar auftragen und kurz einwirken lassen. Haare im Anschluss Glätten um den [CLAIM] zu verstärken. Bei Bedarf das Spray noch einmal als Finisch aufsprühen. Styling Hack: Für die ultimative \"Glass Hair\" Routine, zuerst den [CLAIM] Primer im handtuchtrockenen Haar verteilen und die Haare föhnen. Im Anschluss das [CLAIM] Spray auf das trockene Haar sprühen und die Haare glätten. Das Ergebnis: [CLAIM], glattes \"Glass Hair\" Haar!"
      },
      {
        "source_slug": "got2b-lockenspray-refresher-curlz",
        "field": ".directions.text",
        "replacements": 1,
        "before": "Auf trockenem Haar auftragen. Sprühe von der Haarmitte bis zu den Spritzen für den ultimativen glossy Look. HACK: bei feinerem Haar den Sprühnebel auf die Hände sprühen und von der Haarmitte bis zu den Spitzen verteilen.",
        "after": "Auf trockenem Haar auftragen. Sprühe von der Haarmitte bis zu den Spritzen für den ultimativen [CLAIM] Look. HACK: bei feinerem Haar den Sprühnebel auf die Hände sprühen und von der Haarmitte bis zu den Spitzen verteilen."
      }
    ],
