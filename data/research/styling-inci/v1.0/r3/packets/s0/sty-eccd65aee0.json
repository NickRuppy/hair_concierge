    "directions_verbatim": true,
    "text": "Sprühen Sie das Produkt großzügig vom Ansatz bis zu den Spitzen auf feuchtes, handtuchtrockenes Haar auf.",
    "tier": "C2",
    "source_class": "manufacturer_page",
