{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaarlie.example/schemas/conditioner-research-v1.6-baseline.json",
  "title": "Chaarlie Conditioner research record v1.6 Stage A baseline",
  "description": "Revised Stage A interchange baseline with the complete calibrated nine-field comparison profile, including product care direction and repair-support level, deterministic unsalted per-field fingerprints, and the legacy salted-hash hydration bridge. Exact directions remain protocol metadata. A strict Zod v4 contract becomes executable authority only in separately approved Stage B.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard_version",
    "analysis_version",
    "product_identity",
    "formula",
    "analysis",
    "review"
  ],
  "properties": {
    "standard_version": {
      "const": "1.6"
    },
    "analysis_version": {
      "type": "string",
      "minLength": 1
    },
    "product_identity": {
      "$ref": "#/$defs/productIdentity"
    },
    "formula": {
      "$ref": "#/$defs/formula"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "review": {
      "$ref": "#/$defs/review"
    }
  },
  "$defs": {
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value",
        "normalized_value",
        "source_id",
        "identity_confidence"
      ],
      "properties": {
        "type": {
          "enum": [
            "ean",
            "gtin",
            "barcode",
            "retailer_sku",
            "retailer_url",
            "manufacturer_formula_code",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "normalized_value": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "identity_confidence": {
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        }
      }
    },
    "productIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "category_key",
        "brand",
        "exact_name",
        "market",
        "pack_size",
        "identifiers",
        "formula_capture_date",
        "formula_fingerprint",
        "identity_status",
        "category_boundary_status",
        "source_ids"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "format": "uuid"
        },
        "category_key": {
          "const": "conditioner"
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "exact_name": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "const": "DE/EU"
        },
        "pack_size": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "formula_capture_date": {
          "type": "string",
          "format": "date"
        },
        "formula_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity_status": {
          "enum": [
            "verified",
            "verified_with_minor_source_difference",
            "provisional_formula_conflict",
            "provisional_identity_conflict",
            "insufficient_information",
            "excluded_product_form"
          ]
        },
        "category_boundary_status": {
          "enum": [
            "eligible",
            "excluded_product_form",
            "identity_rework",
            "formula_rework"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "title",
        "source_type",
        "market",
        "captured_at",
        "supports"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "source_type": {
          "enum": [
            "package_label",
            "manufacturer",
            "retailer_exact_gtin",
            "retailer",
            "scientific_primary",
            "scientific_review",
            "regulatory",
            "secondary_discovery"
          ]
        },
        "market": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "supports": {
          "type": "array",
          "items": {
            "enum": [
              "identity",
              "product_form",
              "formula",
              "claim",
              "method",
              "mechanism",
              "finished_product_result"
            ]
          }
        }
      }
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_inci",
        "normalized_ingredients",
        "formula_fingerprint",
        "sources",
        "formula_status",
        "conflicts"
      ],
      "properties": {
        "raw_inci": {
          "type": "string",
          "minLength": 1
        },
        "normalized_ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "formula_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "formula_status": {
          "enum": [
            "verified",
            "verified_with_minor_difference",
            "provisional_conflict",
            "insufficient"
          ]
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict"
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "scope",
        "description",
        "affected_properties",
        "resolution"
      ],
      "properties": {
        "conflict_id": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "identity",
            "product_form",
            "formula",
            "claim",
            "property"
          ]
        },
        "description": {
          "type": "string"
        },
        "affected_properties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolution": {
          "enum": [
            "resolved",
            "property_unknown",
            "whole_analysis_blocked",
            "retained_minor_difference"
          ]
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation",
        "product_inference",
        "source_id"
      ],
      "properties": {
        "observation": {
          "type": "string"
        },
        "product_inference": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "value",
        "decision_type",
        "confidence",
        "evidence_level",
        "evidence_scope",
        "rationale",
        "formula_observations",
        "product_inferences",
        "supporting_signals",
        "counter_signals",
        "derived_from",
        "profile_fact_ids",
        "source_ids",
        "shared_mechanism_ids",
        "review_status"
      ],
      "properties": {
        "property_id": {
          "type": "string"
        },
        "value": {},
        "decision_type": {
          "enum": [
            "direct_product_property",
            "derived_user_fit"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "evidence_level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4",
            "E5"
          ]
        },
        "evidence_scope": {
          "enum": [
            "formula_only",
            "product_only_test",
            "multi_product_test",
            "human_use",
            "consensus",
            "unclear"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "formula_observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "product_inferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "counter_signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profile_fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shared_mechanism_ids": {
          "type": "array",
          "items": {
            "enum": [
              "M1_DEPOSITION_SURFACE_LUBRICATION",
              "M2_TEMPORARY_FILM_SUPPORT",
              "M3_OPTICAL_ALIGNMENT_FILM",
              "M4_CLAIM_ONLY_PROPRIETARY"
            ]
          }
        },
        "review_status": {
          "enum": [
            "draft",
            "needs_review",
            "approved",
            "provisional",
            "blocked"
          ]
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula_observations",
        "routes",
        "direct_properties",
        "derived_fit",
        "lean_projection",
        "claim_audit",
        "medical_boundary",
        "analysis_fingerprint"
      ],
      "properties": {
        "formula_observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "enum": [
              "R1",
              "R2",
              "R3",
              "R4",
              "R5",
              "R6",
              "R7",
              "R8"
            ]
          }
        },
        "direct_properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "derived_fit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "lean_projection": {
          "$ref": "#/$defs/fullProfile"
        },
        "claim_audit": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "medical_boundary": {
          "enum": [
            "clear_cosmetic_scope",
            "claim_scope_review",
            "medical_abstention"
          ]
        },
        "analysis_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "fullProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditioning_level",
        "weight_potential",
        "care_direction",
        "repair_support_level",
        "primary_focus",
        "secondary_focus",
        "hair_thickness_fit",
        "damage_fit",
        "texture_fit",
        "profile_fingerprint",
        "field_fingerprints",
        "uncertain_fields",
        "assumption_notes"
      ],
      "properties": {
        "conditioning_level": { "enum": ["low", "moderate", "high"] },
        "weight_potential": { "enum": ["low", "moderate", "high"] },
        "care_direction": { "enum": ["protein", "moisture", "balanced"] },
        "repair_support_level": { "enum": ["low", "medium", "high"] },
        "primary_focus": {
          "enum": ["lightness", "detangling", "smoothing", "repair", "shine", "curl_support", "color_care", "general"]
        },
        "secondary_focus": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["lightness", "detangling", "smoothing", "repair", "shine", "curl_support", "color_care"]
          }
        },
        "hair_thickness_fit": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["fine", "medium", "coarse"] }
        },
        "damage_fit": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["healthy", "moderately_damaged", "highly_damaged"] }
        },
        "texture_fit": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["straight", "wavy", "curly", "coily"] }
        },
        "profile_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Versioned SHA-256 of the canonical nine-field profile and standard_version."
        },
        "field_fingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conditioning_level", "weight_potential", "care_direction", "repair_support_level", "primary_focus", "secondary_focus", "hair_thickness_fit", "damage_fit", "texture_fit"],
          "properties": {
            "conditioning_level": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "weight_potential": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "care_direction": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "repair_support_level": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "primary_focus": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "secondary_focus": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "hair_thickness_fit": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "damage_fit": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "texture_fit": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "description": "Deterministic unsalted SHA-256 fingerprints of canonical per-field evidence/value payloads."
        },
        "uncertain_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "conditioning_level", "weight_potential", "care_direction", "repair_support_level",
              "primary_focus", "secondary_focus", "hair_thickness_fit", "damage_fit", "texture_fit"
            ]
          }
        },
        "assumption_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "standard_fingerprint",
        "identity_fingerprint",
        "formula_fingerprint",
        "analysis_fingerprint",
        "events"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "provisional",
            "approved",
            "approved_with_cautions",
            "specialist_review_required",
            "blocked",
            "excluded"
          ]
        },
        "standard_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "formula_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "analysis_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
